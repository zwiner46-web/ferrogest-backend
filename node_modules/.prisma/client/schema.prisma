datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// 1. USUARIOS Y SEGURIDAD (Control de Acceso Jerárquico)
// ------------------------------------------------------
enum Role {
  ADMINISTRADOR
  VENDEDOR
  CONTADOR
  BODEGUERO
  CLIENTE
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String
  role           Role      @default(VENDEDOR)
  name           String
  failedAttempts Int       @default(0)
  lockUntil      DateTime?
  lastLogin      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relaciones
  sales          Sale[]
  purchases      Purchase[]
  kardexEntries  Kardex[]
  journalEntries JournalEntry[]

  @@index([email])
}

// ------------------------------------------------------
// 2. PRODUCTOS E INVENTARIO (Con Borrado Seguro y Búsqueda Rápida)
// ------------------------------------------------------
model Product {
  id          Int       @id @default(autoincrement())
  barcode     String    @unique
  name        String
  category    String
  brand       String?
  description String?
  unitMeasure String    @default("UNIDAD") // Unidad, Caja, Metro, Kg
  buyPrice    Float
  sellPrice   Float
  stock       Int       @default(0)
  minStock    Int       @default(5)
  deletedAt   DateTime? // Respaldo forense (Soft Delete para auditoría)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relaciones
  kardex          Kardex[]
  saleDetails     SaleDetail[]
  purchaseDetails PurchaseDetail[]

  @@index([barcode])
  @@index([name])
  @@index([category])
}

// ------------------------------------------------------
// 3. KÁRDEX DE MOVIMIENTOS (Trazabilidad Contable e Inventario)
// ------------------------------------------------------
model Kardex {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String // 'ENTRADA', 'SALIDA', 'AJUSTE'
  quantity  Int
  reason    String? // Ej: "Venta factura #001", "Compra proveedor", "Reposición"
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
}

// ------------------------------------------------------
// 4. PROVEEDORES Y COMPRAS ENTRANTES
// ------------------------------------------------------
model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  nit       String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id         Int      @id @default(autoincrement())
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  total      Float
  createdAt  DateTime @default(now())

  details PurchaseDetail[]
}

model PurchaseDetail {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  buyPrice   Float
}

// ------------------------------------------------------
// 5. CLIENTES Y CARTERA (Gestión de Créditos y Abonos)
// ------------------------------------------------------
model Client {
  id          Int       @id @default(autoincrement())
  name        String
  document    String    @unique // Cédula / NIT
  phone       String?
  address     String?
  creditLimit Float     @default(0.0) // Cupo máximo de crédito
  deletedAt   DateTime? // Soft Delete para auditorías
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sales              Sale[]
  accountsReceivable AccountReceivable[]
}

model AccountReceivable {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  saleId      Int      @unique
  sale        Sale     @relation(fields: [saleId], references: [id])
  totalAmount Float
  balance     Float // Saldo pendiente por pagar
  dueDate     DateTime // Alertas de vencimiento
  status      String   @default("PENDIENTE") // PENDIENTE, PAGADO, VENCIDO
  createdAt   DateTime @default(now())

  payments Payment[]
}

model Payment {
  id                  Int               @id @default(autoincrement())
  accountReceivableId Int
  accountReceivable   AccountReceivable @relation(fields: [accountReceivableId], references: [id])
  amount              Float
  note                String?
  createdAt           DateTime          @default(now())
}

// ------------------------------------------------------
// 6. VENTAS Y PUNTO DE VENTA (POS)
// ------------------------------------------------------
model Sale {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  clientId      Int?
  client        Client?  @relation(fields: [clientId], references: [id])
  paymentMethod String   @default("EFECTIVO") // EFECTIVO, CREDITO, TRANSFERENCIA
  total         Float
  createdAt     DateTime @default(now())

  details           SaleDetail[]
  accountReceivable AccountReceivable?
}

model SaleDetail {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

// ------------------------------------------------------
// 7. CONTABILIDAD INTEGRADA (NIIF para PYMES - PUC)
// ------------------------------------------------------
enum AccountType {
  ACTIVO
  PASIVO
  PATRIMONIO
  INGRESO
  GASTO
}

model AccountPlan {
  id           Int           @id @default(autoincrement())
  code         String        @unique // Ej: "1105" (Caja), "4135" (Comercio)
  name         String
  type         AccountType
  journalLines JournalLine[]
}

model JournalEntry {
  id          Int           @id @default(autoincrement())
  date        DateTime      @default(now())
  description String // Ej: "Registro automático venta POS #001"
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
}

model JournalLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  account        AccountPlan  @relation(fields: [accountId], references: [id])
  debit          Float        @default(0.0)
  credit         Float        @default(0.0)
}
